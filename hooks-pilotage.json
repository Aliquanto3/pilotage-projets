{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_PILOTAGE}}",
            "args": [
              "-I",
              "-S",
              "{{RACINE_PILOTAGE}}/pilotage/hooks/session_start.py"
            ]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_PILOTAGE}}",
            "args": [
              "-I",
              "-S",
              "{{RACINE_PILOTAGE}}/pilotage/hooks/prompt.py"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_PILOTAGE}}",
            "args": [
              "-I",
              "-S",
              "{{RACINE_PILOTAGE}}/pilotage/hooks/stop.py"
            ]
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_PILOTAGE}}",
            "args": [
              "-I",
              "-S",
              "{{RACINE_PILOTAGE}}/pilotage/hooks/notification.py"
            ]
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_PILOTAGE}}",
            "args": [
              "-I",
              "-S",
              "{{RACINE_PILOTAGE}}/pilotage/hooks/session_end.py"
            ]
          }
        ]
      }
    ]
  }
}
